# ---------------------------------------------------------------------------
# Browser (public) — baked into the React build. Safe to expose.
# ---------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://refxgrhntxbarmbudmeb.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only (Vercel functions in /api). NEVER prefix these with REACT_APP_,
# never commit real values, and only set them in Vercel → Environment Variables.
# ---------------------------------------------------------------------------
# PayMongo secret key (live: sk_live_…, test: sk_test_…) — Dashboard → Developers → API keys
PAYMONGO_SECRET_KEY=
# Secret key of the webhook endpoint …/api/billing/webhook (whsk_…) — event: checkout_session.payment.paid
PAYMONGO_WEBHOOK_SECRET=
# Optional: payment methods offered at checkout (must be enabled on your PayMongo account)
# PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya
# Supabase service-role / secret key (sb_secret_…) — lets the webhook write subscriptions
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used for checkout redirects (optional; defaults to the request host)
SITE_URL=https://photobooth-seven-sooty.vercel.app

# Admin email alerts (server only). Set privately in Vercel, never in chat.
RESEND_API_KEY=
# Generate a random secret of at least 32 characters; use the SAME value in the
# Supabase scheduler setup (supabase/setup_admin_email_scheduler.sql).
ADMIN_NOTIFICATION_SECRET=
ADMIN_NOTIFICATION_EMAIL=johncasingal63@gmail.com
# Resend's test sender works only for the Resend account owner's own address.
# For production, replace with a sender on a domain verified in Resend.
ADMIN_NOTIFICATION_FROM=PhotoBooth <onboarding@resend.dev>
